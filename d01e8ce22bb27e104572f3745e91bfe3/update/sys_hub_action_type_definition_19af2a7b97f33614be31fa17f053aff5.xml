        <value>(function execute(inputs, outputs) {&#13;
&#13;
    var r = new sn_ws.RESTMessageV2('Google News RSS', 'GET');&#13;
    var response = r.execute();&#13;
    var xml = response.getBody();&#13;
&#13;
    var news = "";&#13;
&#13;
    try {&#13;
        var items = xml.split("&lt;item&gt;").slice(1);&#13;
        var count = 0;&#13;
&#13;
        for (var i = 0; i &lt; items.length &amp;&amp; count &lt; 10; i++) {&#13;
&#13;
            var item = items[i];&#13;
&#13;
            // Title&#13;
            var title = (item.match(/&lt;title&gt;(.*?)&lt;\/title&gt;/i) || [])[1] || "";&#13;
            title = title.replace(/&amp;amp;/g, "&amp;").trim();&#13;
&#13;
            // Link&#13;
            var link = (item.match(/&lt;link&gt;(.*?)&lt;\/link&gt;/i) || [])[1] || "";&#13;
&#13;
            // 🔥 Description&#13;
            var desc = (item.match(/&lt;description&gt;([\s\S]*?)&lt;\/description&gt;/i) || [])[1] || "";&#13;
&#13;
            // ✅ STEP 1: Decode HTML (VERY IMPORTANT)&#13;
            desc = desc.replace(/&amp;lt;/g, "&lt;")&#13;
                       .replace(/&amp;gt;/g, "&gt;")&#13;
                       .replace(/&amp;amp;/g, "&amp;")&#13;
                       .replace(/&amp;nbsp;/g, " ");&#13;
&#13;
            // ✅ STEP 2: Remove ALL HTML tags&#13;
            desc = desc.replace(/&lt;[^&gt;]*&gt;/g, "");&#13;
&#13;
            // Remove title duplication&#13;
            desc = desc.replace(new RegExp(title, "i"), "");&#13;
&#13;
            // Clean spaces&#13;
            desc = desc.replace(/\s+/g, " ").trim();&#13;
&#13;
            // Limit length&#13;
            desc = desc.substring(0, 150);&#13;
&#13;
            // Date&#13;
            var pubDate = (item.match(/&lt;pubDate&gt;(.*?)&lt;\/pubDate&gt;/i) || [])[1] || "";&#13;
            var dateStr = "";&#13;
&#13;
            try {&#13;
                var gdt = new GlideDateTime(pubDate);&#13;
                dateStr = gdt.getDisplayValue();&#13;
            } catch (e) {&#13;
                dateStr = "";&#13;
            }&#13;
&#13;
            count++;&#13;
&#13;
            news += count + ". " + title + "\n";&#13;
            news += desc + "\n";&#13;
            news += "🔗 " + link + "\n";&#13;
            news += "📅 " + dateStr + "\n\n";&#13;
        }&#13;
&#13;
        outputs.news_list = news || "No news found.";&#13;
&#13;
    } catch (e) {&#13;
        outputs.news_list = "Error: " + e.message;&#13;
    }&#13;
&#13;
})(inputs, outputs);</value>
