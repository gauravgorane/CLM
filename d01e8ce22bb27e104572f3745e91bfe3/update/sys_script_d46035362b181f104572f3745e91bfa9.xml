        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    // 1. Set PAN Request State to 'Complete Skipped' / 'Closed Incomplete'
    // Verify your sys_choice value for 'Complete Skipped' (commonly '7', '4', or '8')
    current.setValue('state', '7'); 

    // 2. Query and reject all child site requests linked to this PAN
    var siteGr = new GlideRecord('x_birl3_clm_nt_site_request');
    siteGr.addQuery('pan_request', current.getUniqueValue());
    siteGr.query();

    while (siteGr.next()) {
        siteGr.setValue('approval', 'rejected');
        siteGr.update();
    }

})(current, previous);]]></script>
