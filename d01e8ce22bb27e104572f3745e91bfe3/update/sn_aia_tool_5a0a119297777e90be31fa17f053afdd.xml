    <sn_aia_tool action="INSERT_OR_UPDATE">
        <active>true</active>
        <description>This tool queries customer name</description>
        <input_schema>[{"name":"sysid","description":"","mandatory":false}]</input_schema>
        <name>Query Customer name</name>
        <record_type>custom</record_type>
        <script><![CDATA[(function(inputs) {
// only string inputs are allowed 
// return outputs object where the keys in it are understandable by LLM
var customername = '';
var getcustomer = new GlideRecord('x_birl3_clm_customer_master_data');
getcustomer.addEncodedQuery('sys_id='+inputs.sysid);
getcustomer.query();
if(getcustomer.next()){

customername = getcustomer.customer.toString();

}
return customername;
})(inputs);]]></script>
