        <script><![CDATA[(function executeRule(current, previous) {
    if (!current.isNewRecord() && !current.donor.changes() && !current.swap_type.changes()) return;
 
    var util = new KeyLimitSwapUtil();
    var res = util.resolveApprovers(current);
 
    if (util.CFG.STRICT_APPROVER_CHECK && res.missing.length > 0) {
        gs.addErrorMessage('No approver is mapped in the approval matrix for: ' + res.missing.join(', ') +
            ' (donor segment: ' + current.getValue('donor_segment') + ', swap type: ' + current.getValue('swap_type') +
            '). Please contact the CLM admin.');
        current.setAbortAction(true);
    }
})(current, previous);]]></script>
