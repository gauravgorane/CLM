        <advanced_condition><![CDATA[(function checkBatchCompletion() {
    // 1. NT PAN Request: Fire ONLY when all child site rows in the batch have succeeded
    var panReqId = current.getValue('nt_request');
    if (panReqId) {
        var pendingPan = new GlideRecord('x_birl3_clm_clm_servicenow_to_sap_send_back');
        pendingPan.addQuery('nt_request', panReqId);
        pendingPan.addQuery('u_status', '!=', 'Success');
        pendingPan.setLimit(1);
        pendingPan.query();
        answer = !pendingPan.hasNext();
        return;
    }

    // 2. Limit Swap Request: Fire ONLY when both Donor and Donee rows have succeeded
    var swapReqId = current.getValue('nt_ls_request');
    if (swapReqId) {
        var pendingSwap = new GlideRecord('x_birl3_clm_clm_servicenow_to_sap_send_back');
        pendingSwap.addQuery('nt_ls_request', swapReqId);
        pendingSwap.addQuery('u_status', '!=', 'Success');
        pendingSwap.setLimit(1);
        pendingSwap.query();
        answer = !pendingSwap.hasNext();
        return;
    }

    // 3. BG Monitor (bg_request): Single row per adjustment — fire immediately
    answer = true;
})();]]></advanced_condition>
