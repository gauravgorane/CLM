        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {

    if (isLoading || !newValue) {
        return;
    }

    var ga = new GlideAjax('GetCustomerDetails');
    ga.addParam('sysparm_name', 'getDetails');
    ga.addParam('sysparm_customer', newValue);

    ga.getXMLAnswer(function(response) {

        if (response) {

            var data = JSON.parse(response);

            g_form.setValue('category', data.category);
            g_form.setValue('max_safe_limit', data.max_safe_limit);
            g_form.setValue('requested_limit', data.requested_limit);
        }
    });
}
]]></script>
