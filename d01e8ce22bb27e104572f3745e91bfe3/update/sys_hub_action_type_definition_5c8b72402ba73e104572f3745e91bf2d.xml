        <value>(function execute(inputs, outputs) {&#13;
 var req = new sn_ws.RESTMessageV2();&#13;
    // Unescape the endpoint (real '&amp;' not &amp;amp;)&#13;
    req.setEndpoint('https://speed.eye2serve.com:7777/XISOAPAdapter/MessageServlet?senderParty=&amp;senderService=BusService_SFA&amp;receiverParty=&amp;receiverService=BS_GRP300&amp;interface=MI_CustOutstanding_USS&amp;interfaceNamespace=http://CustOutstanding:uss.com');&#13;
    // Correct headers for SOAP 1.1&#13;
    req.setRequestHeader('Content-Type', 'text/xml; charset=utf-8');&#13;
    req.setRequestHeader('Accept', 'text/xml');&#13;
req.setHttpMethod('POST');&#13;
    var body =&#13;
      '&lt;?xml version="1.0" encoding="UTF-8"?&gt;' +&#13;
      '&lt;soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:cus="http://CustOutstanding:uss.com"&gt;' +&#13;
      '  &lt;soapenv:Header/&gt;' +&#13;
      '  &lt;soapenv:Body&gt;' +&#13;
      '    &lt;cus:MT_CustOutstanding_Req_USS&gt;' +&#13;
      // NOTE: Depending on the provider’s schema, this child element may need the 'cus' prefix as well.&#13;
      // If they require namespaced children, change to &lt;cus:Customer_Code&gt;...&lt;/cus:Customer_Code&gt;&#13;
      '      &lt;Customer_Code&gt;630207S002&lt;/Customer_Code&gt;' +&#13;
      '    &lt;/cus:MT_CustOutstanding_Req_USS&gt;' +&#13;
      '  &lt;/soapenv:Body&gt;' +&#13;
      '&lt;/soapenv:Envelope&gt;';&#13;
&#13;
    req.setRequestBody(body);&#13;
&#13;
&#13;
    // req.setAuthenticationProfile('basic', 'alias_sap_xi_basic');&#13;
&#13;
    // TEMP ONLY (remove in prod): direct basic auth for quick test&#13;
    // !!!! Do not keep secrets in code !!!!&#13;
    req.setBasicAuth('po_wsdl', 'Poqa@2019');&#13;
&#13;
    // Optional: timeout and MID routing&#13;
    req.setHttpTimeout(60000);&#13;
    // req.setMIDServer('YOUR_MID_NAME'); // if endpoint is reachable only via MID&#13;
&#13;
    var res = req.execute();&#13;
    var status = res.getStatusCode();&#13;
    var bodyOut = res.getBody();&#13;
    var err = res.getErrorMessage();&#13;
    outputs.result = bodyOut;&#13;
})(inputs, outputs);&#13;
