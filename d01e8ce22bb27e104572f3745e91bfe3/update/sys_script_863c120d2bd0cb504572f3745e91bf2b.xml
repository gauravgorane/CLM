        <script><![CDATA[(function executeRule(current, previous) {

    if (current.customer_type + '' !== 'Trade') return;

    var gdt = new GlideDateTime();
    gdt.addMonthsUTC(1);
    gdt.setDayOfMonthUTC(1);
    gdt.addDaysUTC(-1);
    gdt.addMonthsUTC(12);
    current.next_review_date = gdt.getDate();

    // ── NEW: compute code-level approved limit ──
    var requestedPanLevel = parseFloat(current.requested_limit) || 0;
    var approvedPanLevel  = parseFloat(current.approved_limit)  || requestedPanLevel;
    var codeLevelRequested = parseFloat(current.u_code_level_total_requested) || 0;

    var reduction = requestedPanLevel - approvedPanLevel;
    var approvedCodeLimit = codeLevelRequested - reduction;
    if (approvedCodeLimit < 0) approvedCodeLimit = 0;

    current.u_approved_code_limit = approvedCodeLimit;

    gs.info(']]>🔥<![CDATA[ FINAL DATE (NEW BR): ' + current.next_review_date +
             ' | Approved Code Limit: ' + approvedCodeLimit);

})(current, previous);]]></script>
