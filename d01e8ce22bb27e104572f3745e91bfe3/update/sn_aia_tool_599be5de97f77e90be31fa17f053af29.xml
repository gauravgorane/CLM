<?xml version="1.0" encoding="UTF-8"?><record_update sys_domain="cacbc7742bb676104572f3745e91bf5a" table="sn_aia_tool">
    <sn_aia_tool action="INSERT_OR_UPDATE">
        <active>true</active>
        <description>Find all the customer name and take it as input for the AI Agent as company name</description>
        <input_schema>[]</input_schema>
        <name>Find Customer name in customer master table</name>
        <record_type>custom</record_type>
        <script><![CDATA[(function(inputs) {

    var customers = [];

    var gr = new GlideRecord('x_birl3_clm_clm_customer_master1');
    gr.addQuery('is_active', true);
    gr.query();

    while (gr.next()) {
        customers.push(gr.getValue('customer_name'));
    }

    return {
        customer_names: customers
    };

})(inputs);]]></script>
