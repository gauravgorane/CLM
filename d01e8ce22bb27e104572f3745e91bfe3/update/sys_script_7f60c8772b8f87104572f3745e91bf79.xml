        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    // Safely parse each aging bucket, defaulting to 0 if empty or null
    var b1 = parseFloat(current.getValue('ageing_0_60d')) || 0;
    var b2 = parseFloat(current.getValue('ageing_61_75d')) || 0;
    var b3 = parseFloat(current.getValue('ageing_76_90d')) || 0;
    var b4 = parseFloat(current.getValue('ageing_90d')) || 0;

    // Sum the buckets and set the total
    var total = b1 + b2 + b3 + b4;
    current.setValue('total_outstanding', total);

})(current, previous);]]></script>
