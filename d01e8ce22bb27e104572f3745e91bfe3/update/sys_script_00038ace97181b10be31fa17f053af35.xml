        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var swapReqId = current.getValue('nt_ls_request');
    if (!swapReqId) return;

    // Check if either party (Donor or Donee) row is still pending or failed
    var pendingSwapRows = new GlideRecord('x_birl3_clm_clm_servicenow_to_sap_send_back');
    var qcSwap = pendingSwapRows.addQuery('nt_ls_request', swapReqId);
    pendingSwapRows.addQuery('u_status', '!=', 'Success');
    pendingSwapRows.setLimit(1);
    pendingSwapRows.query();

    // Proceed only if both Donor and Donee writeback rows have succeeded
    if (!pendingSwapRows.hasNext()) {
        // Update Limit Swap Request state to 3
        var swapGr = new GlideRecord('x_birl3_clm_nt_limit_swap_request');
        if (swapGr.get(swapReqId)) {
            swapGr.setValue('state', '3');
            swapGr.update();
        }

        gs.info('CLM SAP Writeback Sync: Limit Swap Request ' + swapReqId + ' set to State 3.');
    }

})(current, previous);]]></script>
