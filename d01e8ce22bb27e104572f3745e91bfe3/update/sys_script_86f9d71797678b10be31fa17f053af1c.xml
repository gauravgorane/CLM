        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    // CG1 -> Customer Type
    var cg1 = (current.getValue('cg1') || '').trim().toUpperCase();
    if (cg1 === 'T00') {
        current.setValue('customer_type', 'Trade'); // use the choice VALUE, not label
    }

    // Company Desc -> Segment
    var company = (current.getValue('company_desc') || '').trim().toUpperCase();
 var segmentMap = {
    'UTCL': 'Cement',
    'URMC': 'RMC',
    'URMX': 'RMC',
    'BPD' : 'BPD',
    'GIL' : 'BPD'
};

    if (segmentMap.hasOwnProperty(company)) {
        current.setValue('segment', segmentMap[company]);
    }

})(current, previous);]]></script>
