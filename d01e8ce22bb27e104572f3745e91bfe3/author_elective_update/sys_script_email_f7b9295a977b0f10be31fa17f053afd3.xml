<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_script_email">
    <sys_script_email action="DELETE">
        <name>clm_rfi_mention_body</name>
        <new_lines_to_html>false</new_lines_to_html>
        <script><![CDATA[(function runMailScript(current, template, email, email_action, event) {
    var userId = event.parm1 ? event.parm1.toString() : '';
    var recipientName = 'Colleague';

    if (userId) {
        var userGr = new GlideRecord('sys_user');
        if (userGr.get(userId)) {
            recipientName = userGr.getDisplayValue('name');
        }
    }

    var requestNumber = current.getValue('number') || '';
    var panNumber = current.getValue('pan') || '';
    var instanceUrl = gs.getProperty('glide.servlet.uri');
    var portalUrl = instanceUrl + 'sp?id=clm_credit_requests&number=' + encodeURIComponent(requestNumber);

    template.print('<p style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">Hello ' + recipientName + ',</p>');
    template.print('<p style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">You were mentioned in Credit Limit Request <strong>' + requestNumber + '</strong> (PAN: <strong>' + panNumber + '</strong>).</p>');
    template.print('<p style="margin: 20px 0;"><a href="' + portalUrl + '" style="background-color: #C8102E; color: #ffffff; padding: 10px 20px; text-decoration: none; border-radius: 4px; font-weight: bold; display: inline-block;">View Limit Request Details</a></p>');
    template.print('<p style="font-family: Arial, sans-serif; font-size: 12px; color: #777;">You have also been added to the Watch List for future updates on this request.</p>');
})(current, template, email, email_action, event);]]></script>
