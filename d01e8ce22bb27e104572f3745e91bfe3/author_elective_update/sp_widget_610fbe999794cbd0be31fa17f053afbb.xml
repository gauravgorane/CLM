        <template><![CDATA[<div class="panel panel-default" style="padding:20px;">

    <h3>Customer Credit Lookup</h3>

    <div class="form-group">
        <label>Customer Code</label>
        <input type="text" class="form-control" ng-model="c.customer_code" placeholder="Enter Customer Code"/>
    </div>

    <button class="btn btn-primary" ng-click="c.getCredit()">Search</button>

    <br/><br/>

    <div ng-if="c.data.credit">
        <h4>Credit Limit:</h4>
        <p style="font-size:18px; color:green;">
            {{c.data.credit}}
        </p>
    </div>

</div>]]></template>
