        <script><![CDATA[(function runAction(current, event, email, logger, classifier) {

    var panId = (current.getValue('document_id') || current.getValue('sysapproval') || '') + '';
    var panGr = new GlideRecord('x_birl3_clm_nt_pan_request');
    if (!panId || !panGr.get(panId)) return;

    // 1. Add comment to PAN Request table
    panGr.comments = 'TEST Inbound Comment on PAN Request';
    panGr.update();

    // 2. Add comment to Approval table
    current.comments = 'TEST Inbound Comment on Approval';
    current.update();

})(current, event, email, logger, classifier);]]></script>
