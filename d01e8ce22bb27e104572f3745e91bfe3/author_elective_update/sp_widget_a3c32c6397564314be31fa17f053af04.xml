        <option_schema/>
        <public>false</public>
        <roles/>
        <script><![CDATA[(function() {

    data.viewLabel = 'NT Cement TSH';
    data.userName  = gs.getUserDisplayName();

    // ---- Embed all four live widgets. Confirm these IDs exactly match
    // the "ID" field on each widget record in sp_widget. ----
    data.portfolioWidget      = $sp.getWidget('clm_nt_nsh_portfolio', {});
    data.customer360Widget = $sp.getWidget('clm_nt_nsh_customer_360', {
    search: $sp.getParameter('search') || $sp.getParameter('customer_code') || ''
});
    data.approvalRequestsWidget = $sp.getWidget('clm_nt_nsh_approval_requests', {});
    data.requestDetailWidget  = $sp.getWidget('clm_nt_nsh_request_details', {});

})();]]></script>
