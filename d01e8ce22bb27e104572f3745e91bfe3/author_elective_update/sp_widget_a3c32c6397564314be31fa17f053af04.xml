<?xml version="1.0" encoding="UTF-8"?><record_update table="sp_widget">
    <sp_widget action="DELETE">
        <category>custom</category>
        <client_script><![CDATA[function($scope, $rootScope) {
  var c = this;
  c.activeTab = 'overview';
  c.loading = false;

  // Bridge: child widgets (Approval Requests, Request Detail, Customer 360)
  // broadcast this event to ask the dashboard to switch tabs. Tab id strings
  // below MUST match the ng-click values used in the dashboard HTML exactly.
  $rootScope.$on('ntclm.switch.tab', function(event, tabId) {
    var validTabs = ['overview', 'approval_requests', 'customer360', 'request_detail'];
    if (validTabs.indexOf(tabId) > -1) {
      c.activeTab = tabId;
    }
  });
	$rootScope.$on('clm.switch.tab', function(event, tabId) {
  var validTabs = ['overview', 'approval_requests', 'customer360', 'request_detail'];
  if (validTabs.indexOf(tabId) > -1) { c.activeTab = tabId; }
});
	
}]]></client_script>
        <controller_as>c</controller_as>
        <css>.clm-dash {
  font-family: "Helvetica Neue", Arial, sans-serif;
  color: #1f2933;
  background: #f4f5f7;
  padding-bottom: 24px;
}

/* ---------- Breadcrumb ---------- */
.clm-breadcrumb {
  padding: 10px 20px;
  font-size: 13px;
  color: #5b6470;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

/* ---------- Tabs ---------- */
.clm-tabs {
  display: flex;
  gap: 28px;
  padding: 0 20px;
  background: #fff;
  border-bottom: 1px solid #e3e6eb;
}
.clm-tab {
  padding: 12px 2px;
  color: #6b7280;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  border-bottom: 3px solid transparent;
  text-decoration: none;
}
.clm-tab:hover {
  color: #374151;
  text-decoration: none;
}
.clm-tab.active {
  color: #14141a;
  border-bottom-color: #f5c500;
}

/* ---------- Loading ---------- */
.clm-loading {
  text-align: center;
  padding: 20px;
  color: #8a93a0;
  font-size: 13px;
}</css>
