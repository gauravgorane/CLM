        <template><![CDATA[<div class="clm-dash" ng-cloak ng-if="c.data">

  <div class="clm-breadcrumb">
  </div>

  <div class="clm-tabs">
    <a class="clm-tab"
       ng-class="{active: c.activeTab === 'overview'}"
       ng-click="c.activeTab = 'overview'">
      Portfolio Overview
    </a>
    <a class="clm-tab"
       ng-class="{active: c.activeTab === 'approval_requests'}"
       ng-click="c.activeTab = 'approval_requests'">
      Approval Requests
    </a>
    <a class="clm-tab"
       ng-class="{active: c.activeTab === 'customer360'}"
       ng-click="c.activeTab = 'customer360'">
      Customer 360
    </a>
    <a class="clm-tab"
       ng-class="{active: c.activeTab === 'request_detail'}"
       ng-click="c.activeTab = 'request_detail'">
      Request Detail
    </a>
  </div>

  <!-- Portfolio Overview -->
  <div ng-if="c.activeTab === 'overview'">
    <sp-widget widget="c.data.portfolioWidget"></sp-widget>
  </div>

  <!-- Approval Requests -->
  <div ng-show="c.activeTab === 'approval_requests'">
    <sp-widget widget="c.data.approvalRequestsWidget"></sp-widget>
  </div>

  <!-- Customer 360 -->
  <div ng-if="c.activeTab === 'customer360'">
    <sp-widget widget="c.data.customer360Widget"></sp-widget>
  </div>

  <!-- Request Detail -->
  <div ng-show="c.activeTab === 'request_detail'">
    <sp-widget widget="c.data.requestDetailWidget"></sp-widget>
  </div>

  <div class="clm-loading" ng-if="c.loading">
    Loading CLM data&hellip;
  </div>
</div>]]></template>
