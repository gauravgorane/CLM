        <client_script><![CDATA[api.controller = function($scope) {
  var c = this;

  c.loading = false;
  c.inserting = false;
  c.testResult = null;

  c.refresh = function() {
    c.loading = true;
    c.server.get({ action: 'load' }).then(function(resp) {
      c.data = resp.data;
      c.loading = false;
    }, function() {
      c.loading = false;
    });
  };

  c.testInsert = function() {
    c.inserting = true;
    c.testResult = null;
    c.server.get({ action: 'test_insert' }).then(function(resp) {
      c.inserting = false;
      c.testResult = resp.data.testResult;
      // Refresh visible lists after test insert
      if (resp.data.queueRecords) c.data.queueRecords = resp.data.queueRecords;
      if (resp.data.monitorRecords) c.data.monitorRecords = resp.data.monitorRecords;
    }, function(err) {
      c.inserting = false;
      c.testResult = { ok: false, message: 'Server communication failed: ' + JSON.stringify(err) };
    });
  };
};]]></client_script>
